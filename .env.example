# Coinbase Commerce (crypto checkout)
# https://beta.commerce.coinbase.com/settings/security
COINBASE_COMMERCE_API_KEY=

# Plaid (bank account linking for ACH)
# https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Dwolla (ACH transfer processing)
# https://dashboard.dwolla.com/applications
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_ENV=sandbox
# The Dwolla funding-source URL that receives customer payments (your business bank account, verified in Dwolla)
DWOLLA_MASTER_FUNDING_SOURCE_URL=

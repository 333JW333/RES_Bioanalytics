# Supabase (accounts, orders, inventory)
# https://supabase.com/dashboard/project/_/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile secret — the /contact inquiry form verifies its
# captcha token server-side with this (auth forms are verified by Supabase).
TURNSTILE_SECRET_KEY=

# Resend API key (send-only, restricted to ecopeps.com) — emails /contact
# inquiries to support@ecopeps.com. Without it inquiries are still saved
# to the Supabase `enquiries` table.
RESEND_API_KEY=

# Coinbase Commerce (crypto checkout)
# https://beta.commerce.coinbase.com/settings/security
COINBASE_COMMERCE_API_KEY=

# Plaid (bank account linking for ACH)
# https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Dwolla (ACH transfer processing)
# https://dashboard.dwolla.com/applications
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_ENV=sandbox
# The Dwolla funding-source URL that receives customer payments (your business bank account, verified in Dwolla)
DWOLLA_MASTER_FUNDING_SOURCE_URL=

# PayRam (card payments, settled to you in stablecoin)
# PayRam is self-hosted — deploy your own instance (see https://docs.payram.com)
# and point this at that instance's base URL, not a shared PayRam domain.
PAYRAM_API_BASE_URL=
PAYRAM_API_KEY=
